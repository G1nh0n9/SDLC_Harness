{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-harness/handoff.schema.json",
  "title": "Agent Workflow Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "mission_id",
    "revision",
    "task_id",
    "stage",
    "candidate_id",
    "sender_role",
    "receiver_role",
    "claims",
    "expected_results",
    "decision_rules",
    "observations",
    "decision",
    "assumptions",
    "unresolved",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "document_type": {
      "enum": ["work-order", "work-order-result", "artifact-manifest", "review-finding", "gate-result"]
    },
    "mission_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "stage": {"type": "string", "minLength": 1},
    "candidate_id": {"type": ["string", "null"]},
    "sender_role": {"type": "string", "minLength": 1},
    "receiver_role": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim", "artifact_sha256s", "observation_ids"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "artifact_sha256s": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
          },
          "observation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "expected_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_result_id", "description", "owner_role", "decision_rule_ids"],
        "properties": {
          "expected_result_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "owner_role": {"type": "string", "minLength": 1},
          "decision_rule_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "decision_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_rule_id", "description", "owner_role"],
        "properties": {
          "decision_rule_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "owner_role": {"type": "string", "minLength": 1}
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "expected_result_id",
          "artifact_sha256",
          "observed_value",
          "outcome"
        ],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "expected_result_id": {"type": "string", "minLength": 1},
          "artifact_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "observed_value": {"type": ["string", "number", "integer", "boolean", "null"]},
          "outcome": {"enum": ["pass", "fail", "inconclusive"]}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "applied_rule_ids", "rationale"],
      "properties": {
        "outcome": {"enum": ["pass", "fail", "inconclusive"]},
        "applied_rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "path", "sha256", "media_type"],
        "properties": {
          "artifact_type": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "media_type": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
